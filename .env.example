# DATABASE_URL: PostgreSQL connection string used to store user accounts
# (replaces the old in-memory Map + data/users.json file).
# Local dev with the included docker-compose.yml: postgresql://postgres:postgres@localhost:5432/curator_ai
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/curator_ai"

# REDIS_URL: Redis connection string used to store onboarding/demo sessions
# (replaces the old in-memory sessions Map). Sessions expire after 7 days.
# Local dev with the included docker-compose.yml: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console, used by the
# server to verify Google Sign-In ID tokens. Must be the SAME value as
# VITE_GOOGLE_CLIENT_ID below (one Client ID, used on both frontend and backend).
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# VITE_GOOGLE_CLIENT_ID: Same Client ID as above, exposed to the frontend
# (Vite only exposes env vars prefixed with VITE_). This is a public value,
# safe to ship to the browser — it identifies your app to Google, it is not a secret.
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
